# User settings. Existing settings.env is preserved by updates.
BROWSER=brave
WALLPAPER_COLOR=#11111b
WALLPAPER=$HOME/.config/buchhwin-dwl/wallpapers/buchhwin-default.png
WALLPAPER_MODE=image
WALLPAPER_FOLDER=$HOME/Pictures
WALLPAPER_INTERVAL=300
SCREENSHOT_DIR=$HOME/Pictures/Screenshots
KEYBOARD_LAYOUT=de
# Dark GTK/libadwaita applications only inside the buchhwin session.
GTK_THEME=Adwaita:dark
ADW_DEBUG_COLOR_SCHEME=prefer-dark
export GTK_THEME ADW_DEBUG_COLOR_SCHEME
DWL_VERSION=v0.8
WLR_VERSION=0.19.3
# Fedora sources are downloaded at pinned revisions into
# ~/.local/share/buchhwin-dwl. No existing source checkout is required.
# Load .zshenv, .zprofile and .zshrc before starting the graphical session.
LOAD_ZSH_CONFIG=1
